// Deploy: firebase deploy --only storage
// career_cvs: size cap. franchise_brochure / company_profile: no app-enforced size (deploy rules after changes).

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /career_cvs/{fileName} {
      allow write: if request.resource.size < 15 * 1024 * 1024;
      allow read: if true;
    }

    match /franchise_brochure/{fileName} {
      allow write: if true;
      allow read: if true;
    }

    match /company_profile/{fileName} {
      allow write: if true;
      allow read: if true;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
